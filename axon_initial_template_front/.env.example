# Server-only values. Real values come by DM; never commit them. Same keys go into Vercel env vars.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
AI_CACHE=on
CONNECTOR_SECRET=
# Supabase. With URL + secret key set, the API routes read and write Supabase; without them they use the in-memory seed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Front end: "mock" keeps the demo data in the browser; "api" loads from and saves to Supabase through /api/db.
NEXT_PUBLIC_DATA_SOURCE=mock
