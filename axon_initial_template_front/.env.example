# Backend (not used by the front end yet). Values come from Arjola by DM, never committed.
GEMINI_API_KEY=
# Pinned before the demo (Gemini setup doc) so behaviour cannot change overnight. Check names in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# Used when GEMINI_MODEL is overloaded or slower than 20 s
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional: smaller model for A1, A5, A6
GEMINI_MODEL_SMALL=
AI_CACHE=on
CONNECTOR_SECRET=
# Supabase. With URL + secret key set, the API routes read and write Supabase; without them they use the in-memory seed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Front end: "mock" keeps the demo data in the browser; "api" loads from and saves to Supabase through /api/db.
NEXT_PUBLIC_DATA_SOURCE=mock
